<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Core tests that live in the Unity project (Assets/_EvilCats/Tests/EditMode/Core)
       with the standard .NET test runner, so they run in CI and in this cloud environment. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1591;NUnit2005;NUnit2003;NUnit2004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../EvilCats/Assets/_EvilCats/Tests/EditMode/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../EvilCats.Core/EvilCats.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
